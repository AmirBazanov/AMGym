# Copy to .env and fill in. .env is gitignored, never commit real values.
BOT_TOKEN=
# JSON list of Telegram user ids allowed to use the bot, e.g. [123456789]
ALLOWED_USER_IDS=[]
# Default: SQLite file data/gym.db in the repo root.
# DATABASE_URL=sqlite+aiosqlite:////absolute/path/gym.db
# Later: DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/gym
# Chat LLM (parsing records, answers, advice). Tried in order: every GROQ_MODELS model, then
# OPENROUTER_MODEL and OPENROUTER_FALLBACK_MODELS. A route that answers 429 is skipped for 60 s.
# Groq: free key at https://console.groq.com/keys. Empty = STT_API_KEY below (same Groq account).
GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Free tier: 1000 requests/day and 8000 tokens/min per model, limits are separate per model.
# GROQ_MODELS=["qwen/qwen3.8-27b","openai/gpt-oss-20b","openai/gpt-oss-120b"]
# OpenRouter: the last fallback. Empty key = no OpenRouter routes.
OPENROUTER_API_KEY=
# Pick a current free model at https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=inclusionai/ling-3.1-flash
OPENROUTER_FALLBACK_MODELS=["inclusionai/ling-3.0-flash-sante:free","apodex/apodex-1.1-mini:free"]
# Voice messages: speech-to-text key. Free Groq key at https://console.groq.com/keys
# Voice audio is sent to Groq for recognition. Leave empty to turn voice off.
# With the default Groq STT_BASE_URL this key is also used for the chat LLM when GROQ_API_KEY is empty.
STT_API_KEY=
# STT_BASE_URL=https://api.groq.com/openai/v1
# STT_MODEL=whisper-large-v3-turbo
# STT_MAX_SECONDS=120
# Public HTTPS URL of the Mini App. Leave empty: `python -m gymbot.dev` opens a tunnel and fills it in.
MINIAPP_URL=
TIMEZONE=Europe/Moscow
# Local browser testing without Telegram (never together with a public tunnel):
# RUN_BOT=false
# DEV_USER_ID=1
