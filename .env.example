# Copy to .env and fill in. .env is gitignored, never commit real values.
BOT_TOKEN=
# JSON list of Telegram user ids allowed to use the bot, e.g. [123456789]
ALLOWED_USER_IDS=[]
DATABASE_URL=sqlite+aiosqlite:///./data/gym.db
# Later: DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/gym
OPENROUTER_API_KEY=
# Pick a current free model at https://openrouter.ai/models?max_price=0
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODELS=[]
MINIAPP_URL=
TIMEZONE=Europe/Moscow
