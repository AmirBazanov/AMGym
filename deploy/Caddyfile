# Used only with EDGE=caddy in .env. Template: setup-ec2.sh fills __DOMAIN__ (host from PUBLIC_URL in .env) and __PORT__ (API_PORT, default 8000)
# and writes the result to /etc/caddy/Caddyfile. Caddy gets and renews the Let's Encrypt certificate itself
# (ports 80 and 443 must be open) and proxies everything, including the Telegram webhook, to the app.
__DOMAIN__ {
	# The Mini App's live stream (Server-Sent Events) goes uncompressed: gzip would hold the tiny events
	# in its buffer. reverse_proxy itself flushes text/event-stream right away, no flush_interval needed.
	@compress not path /api/live
	encode @compress gzip
	request_body {
		max_size 1MB
	}
	# No X-Frame-Options: Telegram embeds the Mini App in a frame, frame-ancestors allows only Telegram.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "frame-ancestors https://web.telegram.org https://*.telegram.org"
		Strict-Transport-Security "max-age=31536000"
	}
	reverse_proxy 127.0.0.1:__PORT__
}
